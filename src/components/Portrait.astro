---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { profile } from "@/data/site";

/**
 * Renders the portrait if one exists, and nothing at all if it doesn't.
 *
 * The lookup is a glob rather than a static import on purpose: a static
 * `import portrait from "@/assets/portrait.jpg"` fails the build when the
 * file is absent, which would force a placeholder image to be committed.
 * This way the site is publishable with no photo, and dropping a file into
 * src/assets/ makes it appear on the next build with no code change.
 */
const matches = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/portrait.{jpg,jpeg,png,webp,avif}",
  { eager: true },
);

const portrait = Object.values(matches)[0]?.default;

interface Props {
  /** Caption line under the image, drawing-title-block style. */
  caption?: string;
  class?: string;
  /**
   * Framing, as CSS object-position. Tune these two numbers if the crop sits
   * wrong — lower the second value to move the visible area up the image.
   */
  focus?: string;
}

const {
  caption = profile.location.split(",").slice(0, 2).join(",").trim(),
  class: className = "",
  focus = "50% 32%",
} = Astro.props;
---

{
  portrait && (
    <figure class={`panel corner-ticks group !p-0 overflow-hidden ${className}`}>
      <div class="relative aspect-[4/5] overflow-hidden bg-void">
        <Image
          src={portrait}
          alt={`${profile.name}, ${profile.role}`}
          widths={[400, 640, 900]}
          sizes="(min-width: 1024px) 420px, (min-width: 640px) 50vw, 90vw"
          loading="lazy"
          decoding="async"
          class="portrait-img absolute inset-0 w-full h-full object-cover"
          style={`object-position: ${focus};`}
        />

        {/* Settles a busy background into the palette; releases on hover. */}
        <div class="absolute inset-0 pointer-events-none bg-base/25 mix-blend-multiply transition-opacity duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:opacity-0" />

        {/* Bottom scrim so the caption strip reads against any frame */}
        <div class="absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-base to-transparent pointer-events-none" />

        {/* Registration marks, matching the hero */}
        <div class="absolute inset-3 pointer-events-none" aria-hidden="true">
          {[
            "top-0 left-0 border-t border-l",
            "top-0 right-0 border-t border-r",
            "bottom-0 left-0 border-b border-l",
            "bottom-0 right-0 border-b border-r",
          ].map((pos) => (
            <span class={`absolute w-4 h-4 border-ink/25 ${pos}`} />
          ))}
        </div>
      </div>

      {/* Title block */}
      <figcaption class="flex items-center justify-between gap-3 border-t border-line px-4 py-3">
        <span class="mono-label !text-[9px]">{profile.shortName}</span>
        <span class="mono-label !text-[9px] !text-accent">{caption}</span>
      </figcaption>
    </figure>
  )
}

<style>
  .portrait-img {
    filter: saturate(0.82) contrast(1.06);
    transition: filter 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .group:hover .portrait-img {
    filter: saturate(1) contrast(1);
  }

  @media (prefers-reduced-motion: reduce) {
    .portrait-img {
      filter: none;
      transition: none;
    }
  }
</style>
