---
interface Props {
  eyebrow?: string;
  title?: string;
  lead?: string;
  id?: string;
  class?: string;
  /** Render the header centred */
  center?: boolean;
}

const {
  eyebrow,
  title,
  lead,
  id,
  class: className = "",
  center = false,
} = Astro.props;
---

<section id={id} class={`relative py-20 sm:py-28 ${className}`}>
  <div class="mx-auto max-w-7xl px-6 lg:px-10">
    {
      (eyebrow || title || lead) && (
        <header
          class:list={[
            "max-w-3xl",
            center && "mx-auto text-center",
          ]}
          data-reveal
        >
          {eyebrow && <p class="eyebrow">{eyebrow}</p>}
          {title && (
            <h2 class="mt-5 text-3xl sm:text-4xl lg:text-5xl">{title}</h2>
          )}
          {lead && (
            <p class="mt-5 text-base text-muted leading-relaxed">{lead}</p>
          )}
        </header>
      )
    }

    <slot />
  </div>
</section>
