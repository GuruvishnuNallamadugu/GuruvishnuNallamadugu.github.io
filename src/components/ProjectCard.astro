---
import ProjectDiagram from "./ProjectDiagram.astro";
import type { CollectionEntry } from "astro:content";

interface Props {
  project: CollectionEntry<"projects">;
  index: number;
}

const { project, index } = Astro.props;
const d = project.data;
---

<article
  class="panel corner-ticks group flex flex-col h-full"
  data-tags={JSON.stringify(d.tags)}
  data-reveal
  data-reveal-delay={(index % 3) * 90}
>
  <a href={`/projects/${project.id}/`} class="flex flex-col h-full">
    <!-- Diagram -->
    <div class="relative border-b border-line bg-void/40 aspect-[16/10] overflow-hidden">
      <ProjectDiagram
        type={d.diagram}
        class="absolute inset-0 p-4 transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-[1.04]"
      />

      <!-- Headline metric -->
      <div class="absolute left-0 bottom-0 bg-base/85 backdrop-blur-sm border-t border-r border-line px-4 py-2.5">
        <p class="font-display text-xl font-semibold text-accent leading-none tabular-nums">
          {d.metric.value}
        </p>
        <p class="mono-label mt-1.5 !text-[9px]">{d.metric.label}</p>
      </div>

      <span class="absolute right-4 top-4 font-mono text-[10px] text-dim tracking-[0.16em]">
        {String(d.order).padStart(2, "0")}
      </span>
    </div>

    <!-- Body -->
    <div class="flex flex-col flex-1 p-6">
      <div class="flex items-center gap-2 flex-wrap">
        <span class="mono-label">{d.organization}</span>
        <span class="text-dim text-[10px]">·</span>
        <span class="mono-label">{d.period}</span>
      </div>

      <h3 class="mt-3 text-xl leading-snug transition-colors duration-300 group-hover:text-accent">
        {d.title}
      </h3>

      <p class="mt-3 text-sm text-muted leading-relaxed flex-1">
        {d.summary}
      </p>

      <div class="mt-5 flex flex-wrap gap-1.5">
        {d.tags.map((t: string) => <span class="tag">{t}</span>)}
      </div>

      <div class="mt-5 pt-4 border-t border-line flex items-center justify-between">
        <span class="font-mono text-[10px] uppercase tracking-[0.16em] text-dim transition-colors group-hover:text-accent">
          Read case study
        </span>
        <svg
          width="14"
          height="14"
          viewBox="0 0 14 14"
          fill="none"
          class="text-dim transition-all duration-300 group-hover:text-accent group-hover:translate-x-1"
          aria-hidden="true"
        >
          <path
            d="M3 11L11 3M11 3H5M11 3v6"
            stroke="currentColor"
            stroke-width="1.4"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </div>
    </div>
  </a>
</article>
