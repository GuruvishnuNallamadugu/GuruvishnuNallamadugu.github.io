---
import { navigation, profile } from "@/data/site";

interface Props {
  active: string;
}
const { active } = Astro.props;

const isActive = (href: string) =>
  href === "/" ? active === "/" : active.startsWith(href);
---

<header
  id="site-nav"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-500 border-b border-transparent"
>
  <nav
    class="mx-auto max-w-7xl px-6 lg:px-10 flex items-center justify-between h-[72px]"
    aria-label="Primary"
  >
    <!-- Monogram -->
    <a
      href="/"
      class="group flex items-center gap-3 shrink-0"
      aria-label={`${profile.name} — home`}
    >
      <span
        class="grid place-items-center w-9 h-9 border border-line-bright font-mono text-[13px] font-medium tracking-tight text-ink transition-colors duration-300 group-hover:border-accent group-hover:text-accent"
      >
        {profile.initials}
      </span>
      <span class="hidden sm:flex flex-col leading-none">
        <span class="font-display text-[13px] font-semibold tracking-tight">
          {profile.name}
        </span>
        <span class="mono-label text-[9px] mt-1">{profile.role}</span>
      </span>
    </a>

    <!-- Desktop links -->
    <ul class="hidden lg:flex items-center gap-1">
      {
        navigation.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isActive(item.href) ? "page" : undefined}
              class:list={[
                "relative px-4 py-2 font-mono text-[11px] uppercase tracking-[0.14em] transition-colors duration-300",
                isActive(item.href)
                  ? "text-accent"
                  : "text-muted hover:text-ink",
              ]}
            >
              {item.label}
              {isActive(item.href) && (
                <span class="absolute left-4 right-4 -bottom-0.5 h-px bg-accent" />
              )}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="hidden lg:flex items-center gap-3">
      <a
        href={profile.resumePath}
        target="_blank"
        rel="noopener"
        class="btn btn-ghost !px-4 !py-2 !text-[11px]"
      >
        Résumé
        <svg
          width="11"
          height="11"
          viewBox="0 0 12 12"
          fill="none"
          aria-hidden="true"
        >
          <path
            d="M6 1v8M2.5 6.5L6 10l3.5-3.5M1 11h10"
            stroke="currentColor"
            stroke-width="1.3"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </a>
    </div>

    <!-- Mobile toggle -->
    <button
      id="nav-toggle"
      type="button"
      class="lg:hidden grid place-items-center w-10 h-10 border border-line-bright text-ink"
      aria-label="Toggle navigation menu"
      aria-expanded="false"
      aria-controls="nav-panel"
    >
      <span class="flex flex-col gap-[5px]" aria-hidden="true">
        <span class="block w-4 h-px bg-current"></span>
        <span class="block w-4 h-px bg-current"></span>
        <span class="block w-4 h-px bg-current"></span>
      </span>
    </button>
  </nav>

  <!-- Mobile panel -->
  <div
    id="nav-panel"
    class="lg:hidden fixed inset-0 top-[72px] bg-base/98 backdrop-blur-xl border-t border-line opacity-0 pointer-events-none transition-opacity duration-300"
  >
    <ul class="flex flex-col px-6 py-8 gap-1">
      {
        navigation.map((item, i) => (
          <li class="border-b border-line">
            <a
              href={item.href}
              class:list={[
                "flex items-baseline gap-4 py-5 font-display text-2xl transition-colors",
                isActive(item.href)
                  ? "text-accent"
                  : "text-ink hover:text-accent",
              ]}
            >
              <span class="font-mono text-[10px] text-dim">
                {String(i + 1).padStart(2, "0")}
              </span>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
    <div class="px-6">
      <a
        href={profile.resumePath}
        target="_blank"
        rel="noopener"
        class="btn btn-primary w-full"
      >
        Download Résumé
      </a>
    </div>
  </div>
</header>

<style>
  #site-nav.is-scrolled {
    background-color: color-mix(in srgb, var(--color-base) 88%, transparent);
    backdrop-filter: blur(14px);
    border-bottom-color: var(--color-line);
  }

  #nav-panel.is-open {
    opacity: 1;
    pointer-events: auto;
  }

  #nav-toggle[aria-expanded="true"] span span:nth-child(1) {
    transform: translateY(6px) rotate(45deg);
  }
  #nav-toggle[aria-expanded="true"] span span:nth-child(2) {
    opacity: 0;
  }
  #nav-toggle[aria-expanded="true"] span span:nth-child(3) {
    transform: translateY(-6px) rotate(-45deg);
  }
  #nav-toggle span span {
    transition:
      transform 0.3s var(--ease-out-expo),
      opacity 0.2s;
  }
</style>
